{
  "name": "Export Point Clouds to LAS / LAZ / PLY",
  "type": "app",
  "categories": ["pointclouds", "export"],
  "description": "Every point of each point cloud, at full resolution, with its class and object as one LAS, LAZ or PLY file",
  "docker_image": "supervisely/export-pointclouds-to-las:6.74.62-0.1.0",
  "min_instance_version": "6.19.0",
  "main_script": "src/main.py",
  "modal_template": "src/modal.html",
  "modal_template_state": {
    "format": "laz",
    "classIndices": ""
  },
  "task_location": "workspace_tasks",
  "isolate": true,
  "headless": true,
  "context_menu": {
    "target": ["point_cloud_project", "point_cloud_dataset"],
    "context_root": "Download as"
  }
}
